{
  "title": "SEO content brief",
  "kicker": "",
  "footer_left": "",
  "footer_right": "angelphommachan.com",
  "meta": [
    [
      [
        "Working title",
        50
      ],
      [
        "Writer",
        25
      ],
      [
        "Reviewer",
        25
      ]
    ],
    [
      [
        "Content type",
        50,
        "☐ How-to   ☐ List   ☐ Comparison   ☐ Other:"
      ],
      [
        "Due date",
        25
      ],
      [
        "Publish date",
        25
      ]
    ],
    [
      [
        "Where it will be published",
        50
      ],
      [
        "New post or update?",
        50,
        "☐ New   ☐ Update (link):"
      ]
    ]
  ],
  "blocks": [
    {
      "type": "meta"
    },
    {
      "type": "fields",
      "num": "01",
      "title": "Target audience and goal",
      "fields": [
        [
          "Target audience",
          "Who it's for and what they already know."
        ],
        [
          "Funnel stage",
          "Learning, comparing, or ready to act?",
          "",
          "☐ Awareness     ☐ Consideration     ☐ Decision"
        ],
        [
          "Content goal",
          "What the post should do for the reader and for you."
        ]
      ],
      "height": 42
    },
    {
      "type": "fields",
      "num": "02",
      "title": "Keyword research",
      "hint": "Use any keyword tool, plus Google's People also ask.",
      "fields": [
        [
          "Primary keyword",
          "Monthly search volume and keyword difficulty (KD)."
        ],
        [
          "Secondary keywords",
          "Two or three related phrases."
        ],
        [
          "Keywords to avoid",
          "Keywords your other pages already target."
        ],
        [
          "Search intent",
          "What kind of page ranks for it?",
          "",
          "☐ Informational   ☐ Navigational   ☐ Commercial   ☐ Transactional"
        ],
        [
          "Questions to answer",
          "From People also ask. Use them as headings and FAQs."
        ]
      ],
      "height": 42
    },
    {
      "type": "grid",
      "num": "03",
      "title": "Competitor content (SERP analysis)",
      "hint": "The top three results that aren't ads.",
      "cols": [
        "#",
        "Title and URL",
        "Word count",
        "What it covers",
        "What it misses"
      ],
      "widths": [
        5,
        31,
        11,
        26.5,
        26.5
      ],
      "first": [
        "1",
        "2",
        "3"
      ],
      "height": 40,
      "after": [
        [
          "AI Overview",
          "What it covers and misses, if Google shows one."
        ]
      ]
    },
    {
      "type": "break"
    },
    {
      "type": "fields",
      "num": "04",
      "title": "Content angle",
      "fields": [
        [
          "Content gap",
          "What the top results don't cover."
        ],
        [
          "Unique value",
          "First-hand experience, expert input, or original data."
        ],
        [
          "Editorial angle",
          "Your post's main idea in one sentence."
        ],
        [
          "Target word count",
          "Use the top-ranking pages as a guide."
        ]
      ],
      "height": 52
    },
    {
      "type": "fields",
      "num": "05",
      "title": "On-page SEO",
      "fields": [
        [
          "SEO title",
          "About 50 to 60 characters, primary keyword near the start."
        ],
        [
          "Meta description",
          "About 150 to 160 characters."
        ],
        [
          "URL slug",
          "Short, lowercase, hyphens."
        ]
      ],
      "height": 52
    },
    {
      "type": "callout",
      "tone": "ice",
      "title": "Ready to write?",
      "body": "You can name the audience, search intent, and content gap in one sentence each."
    },
    {
      "type": "grid",
      "num": "06",
      "title": "Content outline",
      "hint": "Questions become H2s. Follow-up questions become H3s.",
      "cols": [
        "Heading level",
        "Heading",
        "Key points",
        "Words"
      ],
      "widths": [
        16,
        36,
        38,
        10
      ],
      "first": [
        "H1 (title)",
        "Intro",
        "H2",
        "H3",
        "H2",
        "H3",
        "H2",
        "H2",
        "FAQ",
        "Conclusion"
      ],
      "prefill": {
        "1": [
          "",
          "Primary keyword in the first 100 words",
          ""
        ],
        "8": [
          "",
          "Questions from section 02",
          ""
        ],
        "9": [
          "",
          "CTA from section 08",
          ""
        ]
      },
      "height": 34
    },
    {
      "type": "break"
    },
    {
      "type": "grid",
      "num": "07",
      "title": "Links, sources, and images",
      "hint": "Link original sources, not competitors. Credit every image.",
      "cols": [
        "Type",
        "URL or file",
        "Anchor text or use",
        "Checked"
      ],
      "widths": [
        16,
        40,
        32,
        12
      ],
      "first": [
        "Internal link",
        "Internal link",
        "External source",
        "External source",
        "External source",
        "Image",
        "Image"
      ],
      "height": 34
    },
    {
      "type": "fields",
      "num": "08",
      "title": "Call to action and KPI",
      "fields": [
        [
          "Call to action (CTA)",
          "What the reader does next, plus the link."
        ],
        [
          "KPI",
          "One number tied to the content goal. Review it monthly."
        ]
      ],
      "height": 52
    },
    {
      "type": "fields",
      "num": "09",
      "title": "Brand voice and guidelines",
      "height": 52,
      "fields": [
        [
          "Voice and tone",
          ""
        ],
        [
          "Must include",
          "Disclaimers, required terms, product names."
        ],
        [
          "Avoid",
          "Claims, words, or topics to leave out."
        ],
        [
          "Style guide",
          "Link to brand or style guidelines."
        ]
      ]
    },
    {
      "type": "check",
      "num": "10",
      "title": "Pre-publish checklist",
      "items": [
        "Primary keyword in the title, first 100 words, and one H2",
        "Title and meta description match section 05",
        "Every number links to a source",
        "Two or three internal links",
        "One or two older posts link to the new one",
        "Images credited, with alt text",
        "CTA matches the content goal",
        "Monthly KPI review on your calendar"
      ]
    }
  ]
}