# Public site URL (used for metadata + sitemap)
NEXT_PUBLIC_SITE_URL=https://angelphommachan.com

# About-me video: upload the convocation video (or your 60-second cut) to YouTube and paste the ID
NEXT_PUBLIC_ABOUT_VIDEO_ID=

# Comments (giscus.app → pick the GitHub repo, enable Discussions, copy these four values)
NEXT_PUBLIC_GISCUS_REPO=angelphomm-sys/angel-website
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=General
NEXT_PUBLIC_GISCUS_CATEGORY_ID=

# Subscribe form → Buttondown (buttondown.com → Settings → API)
BUTTONDOWN_API_KEY=

# Contact form → Resend (resend.com → API keys). CONTACT_FROM needs a verified domain; onboarding@resend.dev works for testing.
RESEND_API_KEY=
CONTACT_TO=angelphommachan@gmail.com
CONTACT_FROM=Portfolio <onboarding@resend.dev>

# Analytics. NEXT_PUBLIC_GA_MEASUREMENT_ID (G-XXXXXXX) turns on GA4 tracking site-wide.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# The /stats page reads GA4 through a service account (Google Cloud → IAM → service account → JSON key; then GA Admin → Property access → add the account email as Viewer).
GA4_PROPERTY_ID=
GA_SERVICE_ACCOUNT_EMAIL=
GA_SERVICE_ACCOUNT_KEY=
# Live YouTube view counts on /stats (Google Cloud → APIs → YouTube Data API v3 → API key).
YOUTUBE_API_KEY=

# Amplitude. NEXT_PUBLIC_AMPLITUDE_API_KEY turns on product analytics + session replay site-wide.
NEXT_PUBLIC_AMPLITUDE_API_KEY=
# Agent Analytics for the /api/ask site assistant (server-side, never exposed to the browser).
AMPLITUDE_AI_API_KEY=
# Google Search Console: HTML tag verification value (Search Console → Settings → Ownership → HTML tag, paste the content= value).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
